# Database
DATABASE_URL=postgresql+asyncpg://surco:surco@localhost:5432/surco

# JWT
JWT_SECRETO=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES
JWT_ALGORITMO=HS256
JWT_EMISOR=surco-api
JWT_AUDIENCIA=surco-app
JWT_ACCESS_MINUTOS=15

# Refresh tokens
REFRESH_DIAS=30

# Login
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Frontend
CORS_ORIGENES=http://localhost:3000
POLITICA_URL=/politica-de-datos

# Diagnóstico satelital: proyecto de Google Earth Engine (humedad SMAP y verdor MODIS).
# Sin él, el diagnóstico corre igual con clima (NASA POWER) y suelo (SoilGrids).
GEE_PROJECT=

# Modelo predictivo: carpeta de ml/modelos_exportados con los modelo_a_*.ubj
MODELO_CORRIDA=tiempo
